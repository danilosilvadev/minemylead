# Hostinger (Apache). HTTPS, one address, and the folders that are not part of the site stay closed.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://minemylead.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://minemylead.com%{REQUEST_URI} [L,R=301]
RewriteRule ^pt/piloto/?$ /pt/teste/ [R=301,L]
RewriteRule ^en/pilot/?$ /en/test/ [R=301,L]
Options -Indexes
